# Postgres thật - đổi user/password/db name theo môi trường của bạn
DATABASE_URL=postgresql+psycopg2://iqkids_user:iqkids_password@localhost:5432/iqkids_db

# Không set = dùng chế độ fallback (game mẫu dựng sẵn, không gọi AI thật)
GEMINI_API_KEY=

# Danh sách origin frontend được phép gọi API (dev: vite ở :3000 hoặc :5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Khóa bí mật ký JWT Token (Production nên thay đổi bằng chuỗi ngẫu nhiên bảo mật)
JWT_SECRET_KEY=iqkids_super_secret_jwt_key_for_edtech_platform_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
